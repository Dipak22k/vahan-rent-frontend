{
  "expo": {
    "name": "VahanRent",
    "slug": "vahan-rent",
    "version": "1.0.0",
    "owner": "kongaridipak",
    "scheme": "vahanrent",
    "orientation": "portrait",
    "icon": "./assets/logoV.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logoV.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vahanrent.app",
      "infoPlist": {
        "CFBundleDisplayName": "VahanRent"
      }
    },
    "android": {
      "package": "com.vahanrent.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoV.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/logoV.png"
    },
    "plugins": [
      "expo-audio",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "1da7e6f7-1f36-4371-af0e-20e96cd8adfd"
      }
    }
  }
}
