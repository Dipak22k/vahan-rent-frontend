{
  "expo": {
    "name": "VahanRent",
    "slug": "vahan-rent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoV.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logoV.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vahanrent.app",
      "infoPlist": {
        "CFBundleDisplayName": "VahanRent"
      }
    },
    "android": {
      "package": "com.vahanrent.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoV.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/logoV.png"
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
